# Server-Side Private Access Password (SERVER-SIDE ONLY - Never prefix with VITE_)
MY_LEARNING_PASSWORD=

# Optional custom Text-to-Speech API URL (Defaults to https://muberes-my-piper-tts.hf.space/tts)
VITE_TTS_BASE_URL=

# Private Telegram Learning Bot (SERVER-SIDE SECRETS - Never prefix with VITE_)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Optional deployed application URL for Telegram deep links (e.g. https://myapptyping.vercel.app)
APP_URL=

# Supabase Client Configuration (Public Anon Key & URL)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Server-Only Administration Key (SERVER-SIDE ONLY - Never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=

# Groq Cloud API Key (14.4k requests/day Free Tier - Ultra-fast Llama 3.3 / 3.1)
GROQ_API_KEY=

# Optional Gemini API Key
GEMINI_API_KEY=

